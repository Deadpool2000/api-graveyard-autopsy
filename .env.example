# ============================================================================
# API Graveyard Autopsy — Environment Configuration Template
# Copy this file to .env and set your GEMINI_API_KEY from Google AI Studio.
# Never commit .env with real secrets.
# ============================================================================

# Google Gemini API Configuration (Server-Side Only — NEVER expose to client)
# Paste your Google AI Studio API key here:
GEMINI_API_KEY=replace_me
# Supported free-tier models in Google AI Studio (e.g. gemma-4-31b-it, gemma-4-26b-a4b-it, gemini-3.8-flash, gemini-3-flash-preview, gemini-3.1-flash-lite)
GEMINI_MODEL=gemma-4-31b-it
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=35
GEMINI_MAX_OUTPUT_TOKENS=4096

# Redis & Worker Configuration
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# Backend API Limits & Security
MAX_UPLOAD_SIZE_MB=5
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:8088

# Host Ports for Docker Containers
NGINX_PORT=80
NGINX_ALT_PORT=8088
FRONTEND_PORT=3000
BACKEND_PORT=8000

